# Copy this file to .env and fill in your values before running the benchmark.
#
#   cp env.example .env

# ── MQTT credentials ──────────────────────────────────────────────────────────
# PASSWORD1 — used by publisher containers as BROKER_PASSWORD
# PASSWORD2 — used by the subscriber container and as the RabbitMQ default user
#             password (must match the subscriber1 user in the RabbitMQ overlay)
PASSWORD1=change-me-publisher-password
PASSWORD2=change-me-subscriber-password

# BROKER_USERNAME — the MQTT username sent by all clients (publishers + subscriber).
# For most brokers this is ignored (they accept anonymous connections).
# For RabbitMQ this must match the default user created by the overlay (subscriber1).
BROKER_USERNAME=subscriber1

# ── Monitoring stack ───────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Prometheus base URL — used by run_load_updated.py to snapshot metrics
# after each execution. Leave as-is when running locally.
PROMETHEUS_URL=http://localhost:9090

# ── Broker selection (set automatically by run_load_updated.py) ───────────────
# These four variables are injected at runtime by run_load_updated.py and
# run_broker_comparison.sh, so you do not need to set them here for normal use.
# Only set them manually if you want to run docker compose directly without
# going through the orchestration scripts.
#
# BROKER_IMAGE=hivemq/hivemq-ce
# BROKER_TYPE=hivemq
# LOG_PATH=aut0_hivemq_1kb_fixed/qos0
# QOS=0
